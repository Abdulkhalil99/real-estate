# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=real_estate_db

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_DIFFERENT_MIN_32_CHARS

# URLs
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_UPLOAD_URL=https://api.yourdomain.com

# GitHub (auto-set by Actions)
GITHUB_REPOSITORY=your-username/real-estate-platform
