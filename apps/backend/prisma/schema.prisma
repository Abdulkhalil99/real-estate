// This tells Prisma how to connect to the database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
// Enums = a field that can only be one of a fixed set of values
// PostgreSQL stores these as strings but validates them for us

enum UserRole {
  ADMIN   // can do everything
  AGENT   // can create/edit properties
  USER    // can browse and send inquiries
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  COMMERCIAL
}

enum InquiryStatus {
  NEW        // just submitted
  CONTACTED  // agent has responded
  CLOSED     // inquiry resolved
}

// ─── USER TABLE ───────────────────────────────────────────────────────────────
// One user can:
//   - list many properties (as an agent)
//   - send many inquiries (as a buyer/renter)

model User {
  id        String   @id @default(cuid())  // cuid = collision-resistant unique id
  email     String   @unique               // no two users can share an email
  password  String                         // bcrypt hashed — never plain text
  firstName String
  lastName  String
  role      UserRole @default(USER)        // new users start as USER
  phone     String?                        // ? = optional field
  avatar    String?                        // URL to profile picture

  // Relationships
  properties Property[]  // properties this user listed as agent
  inquiries  Inquiry[]   // inquiries this user sent
  refreshTokens RefreshToken[]

  // Timestamps — @updatedAt auto-updates on every save
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes speed up common queries
  @@index([email])
  @@index([role])

  // What this table is called in the database
  @@map("users")
}

// ─── PROPERTY TABLE ───────────────────────────────────────────────────────────
// One property:
//   - belongs to one agent (User)
//   - has many images (PropertyImage)
//   - receives many inquiries (Inquiry)

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text   // Text = unlimited length (vs String = 191 chars)
  price       Float
  status      PropertyStatus @default(FOR_SALE)
  type        PropertyType

  // Location
  address String
  city    String
  state   String
  zipCode String
  country String @default("Tunisia")

  // Details
  bedrooms  Int
  bathrooms Float          // Float because 1.5 bathrooms is valid
  area      Float          // square meters
  yearBuilt Int?           // optional
  featured  Boolean        @default(false)  // shown on homepage

  // The agent who listed this property
  // onDelete: CASCADE means if the agent is deleted, their properties are too
  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Relationships
  images    PropertyImage[]
  inquiries Inquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index the most common filter fields for fast queries
  @@index([city])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([agentId])
  @@index([featured])

  @@map("properties")
}

// ─── PROPERTY IMAGE TABLE ─────────────────────────────────────────────────────
// Separated from Property so one property can have unlimited images
// without making the Property row huge

model PropertyImage {
  id         String   @id @default(cuid())
  url        String                          // URL to the image (cloud storage)
  alt        String?                         // accessibility text
  isPrimary  Boolean  @default(false)        // the main thumbnail image
  order      Int      @default(0)            // display order

  // Which property this image belongs to
  // onDelete: Cascade = if property deleted, all its images are deleted too
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

// ─── INQUIRY TABLE ────────────────────────────────────────────────────────────
// When a visitor contacts an agent about a property
// userId is optional because visitors can inquire without an account

model Inquiry {
  id      String        @id @default(cuid())
  name    String                              // visitor's name
  email   String                              // visitor's email
  phone   String?                             // optional phone
  message String        @db.Text
  status  InquiryStatus @default(NEW)


  

  // Which property this inquiry is about
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Which user sent this (optional — guests can inquire without account)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([status])

  @@map("inquiries")
}

// Add this to your existing schema.prisma file
// after the Inquiry model

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}